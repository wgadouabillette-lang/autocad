{
  "name": "forma-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Hall",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "prepare-resources": "node ../scripts/prepare-desktop-resources.cjs",
    "dist:mac": "FORMA_PROD_BUILD=1 npm run prepare-resources && electron-builder --mac dmg",
    "dist:win": "FORMA_PROD_BUILD=1 npm run prepare-resources && electron-builder --config electron-builder.config.cjs --win nsis",
    "dist:linux": "FORMA_PROD_BUILD=1 npm run prepare-resources && electron-builder --linux AppImage",
    "dist": "FORMA_PROD_BUILD=1 npm run prepare-resources && electron-builder --mac dmg --win nsis --linux AppImage"
  },
  "build": {
    "appId": "com.forma.cad",
    "productName": "Hall",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "staticServer.cjs",
      "preload.cjs",
      "recording-camera-preload.cjs",
      "recording-camera-overlay.html",
      "updater.cjs",
      "updater-state.cjs",
      "package.json",
      "build/icon.png",
      "build/icon.ico",
      "spotifyWebView2Manager.cjs",
      "spotify-webview2-host.cjs",
      "spotify-webview2/**"
    ],
    "asarUnpack": [
      "**/node_modules/ewvjs/**"
    ],
    "afterPack": "./afterPack.cjs",
    "afterSign": "./afterSign.cjs",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "extraResources": [
      {
        "from": "build-resources/frontend-dist",
        "to": "frontend-dist"
      },
      {
        "from": "build-resources/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build-resources/backend-venv",
        "to": "backend-venv",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Hall-${version}-mac.${ext}",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Hall a besoin d'accéder à l'écran pour le partage d'écran et l'enregistrement.",
        "NSCameraUsageDescription": "Hall utilise la caméra pour les appels vidéo.",
        "NSMicrophoneUsageDescription": "Hall utilise le micro pour les appels vocaux."
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "verifyUpdateCodeSignature": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "synopsis": "AI-powered collaborative workspace",
      "description": "Hall — AI-powered collaborative workspace for teams.",
      "artifactName": "Hall-${version}-linux.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hall",
      "artifactName": "Hall.${ext}"
    },
    "dmg": {
      "title": "Hall",
      "artifactName": "Hall-${version}-mac.${ext}",
      "contents": [
        {
          "x": 140,
          "y": 200
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "https://github.com/castlabs/electron-releases#v42.5.2+wvcus",
    "electron-builder": "^26.15.3",
    "rcedit": "^4.0.1"
  },
  "optionalDependencies": {
    "ewvjs": "^1.0.25"
  }
}
