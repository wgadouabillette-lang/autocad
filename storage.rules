rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /downloads/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /desktop-updates/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Profile photos: readable by any signed-in user (avatars in chat / presence).
    // Writes restricted to the owner.
    match /users/{uid}/profile/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /users/{uid}/recordings/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 512 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    function isSharedWorkspaceOwnerForStorage(workspaceId) {
      return exists(/databases/(default)/documents/workspacesShared/$(workspaceId))
        && firestore.get(/databases/(default)/documents/workspacesShared/$(workspaceId)).data.ownerId
          == request.auth.uid;
    }

    function isSharedWorkspaceMemberForStorage(workspaceId) {
      return request.auth != null && (
        isSharedWorkspaceOwnerForStorage(workspaceId)
        || exists(/databases/(default)/documents/workspacesShared/$(workspaceId)/members/$(request.auth.uid))
      );
    }

    function isUserWorkspaceOwnerForStorage(workspaceId) {
      return exists(/databases/(default)/documents/users/$(request.auth.uid)/workspaces/$(workspaceId))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)/workspaces/$(workspaceId)).data.ownerId
          == request.auth.uid;
    }

    function isFriendChatParticipant(chatId) {
      return request.auth != null
        && exists(/databases/(default)/documents/friendChats/$(chatId))
        && firestore.get(/databases/(default)/documents/friendChats/$(chatId)).data.participants is list
        && request.auth.uid in firestore.get(/databases/(default)/documents/friendChats/$(chatId)).data.participants;
    }

    function isChatFileContentType() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType.matches('text/.*')
        || request.resource.contentType == 'application/pdf'
        || request.resource.contentType == 'application/json'
        || request.resource.contentType == 'application/zip'
        || request.resource.contentType == 'application/rtf'
        || request.resource.contentType == 'application/msword'
        || request.resource.contentType.matches('application/vnd\\..*');
    }

    match /friendChats/{chatId}/{authorUid}/{batchId}/{fileName} {
      allow read: if isFriendChatParticipant(chatId);
      allow write: if isFriendChatParticipant(chatId)
        && request.auth.uid == authorUid
        && request.resource.size < 20 * 1024 * 1024
        && isChatFileContentType();
      allow delete: if request.auth != null && request.auth.uid == authorUid;
    }

    match /workspaces/{workspaceId}/{fileName} {
      allow read: if request.auth != null && (
        isSharedWorkspaceMemberForStorage(workspaceId)
        || isUserWorkspaceOwnerForStorage(workspaceId)
      );
      allow write: if request.auth != null
        && fileName.matches('icon\\.(jpg|png|webp)')
        && (isSharedWorkspaceOwnerForStorage(workspaceId) || isUserWorkspaceOwnerForStorage(workspaceId))
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
        && fileName.matches('icon\\.(jpg|png|webp)')
        && (isSharedWorkspaceOwnerForStorage(workspaceId) || isUserWorkspaceOwnerForStorage(workspaceId));
    }
  }
}
