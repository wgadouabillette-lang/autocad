{
  "rules": {
    ".read": false,
    ".write": false,

    "workspaceAcl": {
      "$workspaceId": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": false
        }
      }
    },

    "groupAcl": {
      "$groupId": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": false
        }
      }
    },

    "friendAcl": {
      "$pairId": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": false
        }
      }
    },

    "presence": {
      "$workspaceId": {
        ".read": "auth != null && root.child('workspaceAcl').child($workspaceId).child(auth.uid).val() === true",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid && root.child('workspaceAcl').child($workspaceId).child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['uid', 'displayName', 'lastSeen']) && newData.child('uid').val() == auth.uid && newData.child('displayName').isString() && newData.child('displayName').val().length > 0 && newData.child('displayName').val().length <= 120 && newData.child('lastSeen').isNumber()"
        }
      }
    },

    "typing": {
      "theater": {
        "$workspaceId": {
          ".read": "auth != null && root.child('workspaceAcl').child($workspaceId).child(auth.uid).val() === true",
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('workspaceAcl').child($workspaceId).child(auth.uid).val() === true",
            ".validate": "newData.hasChildren(['authorUid', 'authorName', 'updatedAt']) && newData.child('authorUid').val() == auth.uid && newData.child('authorName').isString() && newData.child('updatedAt').isNumber()"
          }
        }
      },
      "channel": {
        "$workspaceId": {
          "$channelId": {
            ".read": "auth != null && root.child('workspaceAcl').child($workspaceId).child(auth.uid).val() === true",
            "$uid": {
              ".write": "auth != null && auth.uid == $uid && root.child('workspaceAcl').child($workspaceId).child(auth.uid).val() === true",
              ".validate": "newData.hasChildren(['authorUid', 'authorName', 'updatedAt']) && newData.child('authorUid').val() == auth.uid && newData.child('authorName').isString() && newData.child('updatedAt').isNumber()"
            }
          }
        }
      },
      "friend": {
        "$chatId": {
          ".read": "auth != null && root.child('friendAcl').child($chatId).child(auth.uid).val() === true",
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('friendAcl').child($chatId).child(auth.uid).val() === true",
            ".validate": "newData.hasChildren(['authorUid', 'authorName', 'updatedAt']) && newData.child('authorUid').val() == auth.uid && newData.child('authorName').isString() && newData.child('updatedAt').isNumber()"
          }
        }
      },
      "group": {
        "$groupId": {
          ".read": "auth != null && root.child('groupAcl').child($groupId).child(auth.uid).val() === true",
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('groupAcl').child($groupId).child(auth.uid).val() === true",
            ".validate": "newData.hasChildren(['authorUid', 'authorName', 'updatedAt']) && newData.child('authorUid').val() == auth.uid && newData.child('authorName').isString() && newData.child('updatedAt').isNumber()"
          }
        }
      }
    },

    "voiceRtc": {
      "$workspaceId": {
        "$sessionId": {
          "$toUid": {
            ".read": "auth != null && auth.uid == $toUid && root.child('workspaceAcl').child($workspaceId).child(auth.uid).val() === true",
            "$pushId": {
              ".write": "auth != null && root.child('workspaceAcl').child($workspaceId).child(auth.uid).val() === true && ((!data.exists() && newData.child('fromUid').val() == auth.uid && newData.child('toUid').val() == $toUid) || (data.exists() && (data.child('fromUid').val() == auth.uid || data.child('toUid').val() == auth.uid) && !newData.exists()))",
              ".validate": "!newData.exists() || (newData.hasChildren(['fromUid', 'toUid', 'type']) && newData.child('type').val().matches(/^(offer|answer|candidate)$/) && newData.child('createdAt').isNumber())"
            }
          }
        }
      }
    },

    "voiceKnocks": {
      "$workspaceId": {
        ".read": "auth != null && root.child('workspaceAcl').child($workspaceId).child(auth.uid).val() === true",
        "$knockId": {
          ".write": "auth != null && root.child('workspaceAcl').child($workspaceId).child(auth.uid).val() === true && ((!data.exists() && newData.child('fromUid').val() == auth.uid) || (data.exists() && (data.child('fromUid').val() == auth.uid || data.child('toUid').val() == auth.uid)))",
          ".validate": "!newData.exists() || (newData.hasChildren(['id', 'workspaceId', 'fromUid', 'fromName', 'toUid', 'status']) && newData.child('status').val().matches(/^(pending|accepted|declined|ejected)$/) && newData.child('toUid').isString() && newData.child('toUid').val().length > 0)"
        }
      }
    }
  }
}
