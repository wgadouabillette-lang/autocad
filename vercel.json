{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "landing": {
      "root": "landing",
      "routePrefix": "/",
      "framework": "vite"
    },
    "frontend": {
      "root": "frontend",
      "routePrefix": "/app",
      "framework": "vite"
    },
    "backend": {
      "entrypoint": "backend/main.py",
      "framework": "fastapi",
      "routePrefix": "/_/backend",
      "memory": 1024,
      "maxDuration": 30,
      "excludeFiles": "backend/{.venv/**,**/__pycache__/**,app/engine/**,app/vision/**,app/ai/**}"
    }
  },
  "redirects": [
    {
      "source": "/downloads/Meetra.exe",
      "destination": "https://firebasestorage.googleapis.com/v0/b/forma-cad-dev.firebasestorage.app/o/downloads%2FMeetra.exe?alt=media",
      "permanent": false
    },
    {
      "source": "/downloads/Hall.exe",
      "destination": "https://firebasestorage.googleapis.com/v0/b/forma-cad-dev.firebasestorage.app/o/downloads%2FMeetra.exe?alt=media",
      "permanent": false
    },
    {
      "source": "/downloads/Hall-windows.exe",
      "destination": "https://firebasestorage.googleapis.com/v0/b/forma-cad-dev.firebasestorage.app/o/downloads%2FMeetra.exe?alt=media",
      "permanent": false
    },
    {
      "source": "/downloads/Hall-mac.dmg",
      "destination": "https://firebasestorage.googleapis.com/v0/b/forma-cad-dev.firebasestorage.app/o/downloads%2FHall-mac.dmg?alt=media",
      "permanent": false
    },
    {
      "source": "/downloads/Meetra-linux.AppImage",
      "destination": "https://firebasestorage.googleapis.com/v0/b/forma-cad-dev.firebasestorage.app/o/downloads%2FMeetra-linux.AppImage?alt=media",
      "permanent": false
    },
    {
      "source": "/downloads/Hall-linux.AppImage",
      "destination": "https://firebasestorage.googleapis.com/v0/b/forma-cad-dev.firebasestorage.app/o/downloads%2FMeetra-linux.AppImage?alt=media",
      "permanent": false
    },
    {
      "source": "/desktop-updates/:file",
      "destination": "https://firebasestorage.googleapis.com/v0/b/forma-cad-dev.firebasestorage.app/o/desktop-updates%2F:file?alt=media",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/_/backend/api/$1"
    },
    {
      "source": "/__/auth/:path*",
      "destination": "https://forma-cad-dev.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://forma-cad-dev.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/auth",
      "destination": "/auth.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/subprocessors",
      "destination": "/subprocessors.html"
    },
    {
      "source": "/google-limited-use",
      "destination": "/google-limited-use.html"
    },
    {
      "source": "/affiliate",
      "destination": "/affiliate.html"
    },
    {
      "source": "/app",
      "destination": "/app/"
    }
  ],
  "headers": [
    {
      "source": "/app",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/auth",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
