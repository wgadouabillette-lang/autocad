{
  "firestore": {
    "database": "(default)",
    "location": "eur3",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Meetra",
        "supportEmail": "wgadouabillette@gmail.com",
        "authorizedRedirectUris": [
          "https://forma-cad-dev.firebaseapp.com",
          "https://forma-cad-dev.firebaseapp.com/__/auth/handler",
          "https://forma-cad-dev.web.app",
          "https://forma-cad-dev.web.app/__/auth/handler",
          "https://meetra.cc",
          "https://meetra.cc/__/auth/handler",
          "https://www.meetra.cc",
          "https://www.meetra.cc/__/auth/handler",
          "https://forma.app",
          "https://forma.app/__/auth/handler",
          "https://autocad-blue.vercel.app",
          "https://autocad-blue.vercel.app/__/auth/handler",
          "http://localhost",
          "http://127.0.0.1"
        ]
      }
    },
    "authorizedDomains": [
      "localhost",
      "127.0.0.1",
      "forma-cad-dev.web.app",
      "forma-cad-dev.firebaseapp.com",
      "forma.app",
      "meetra.cc",
      "www.meetra.cc",
      "autocad-blue.vercel.app"
    ]
  },
  "hosting": {
    "public": "landing",
    "ignore": [
      "node_modules",
      ".git",
      "package.json",
      "package-lock.json",
      "vite.config.js",
      "downloads/**",
      "dist/**",
      "public/**"
    ],
    "rewrites": [
      { "source": "/auth", "destination": "/auth.html" },
      { "source": "/tarifs", "destination": "/tarifs.html" },
      { "source": "/careers", "destination": "/careers.html" },
      { "source": "/ressources", "destination": "/ressources.html" },
      { "source": "/terms", "destination": "/terms.html" },
      { "source": "/privacy", "destination": "/privacy.html" },
      { "source": "/subprocessors", "destination": "/subprocessors.html" },
      { "source": "/google-limited-use", "destination": "/google-limited-use.html" },
      { "source": "/affiliate", "destination": "/affiliate.html" }
    ],
    "redirects": [
      { "source": "/index.html", "destination": "/", "type": 301 },
      { "source": "/auth.html", "destination": "/auth", "type": 301 },
      { "source": "/tarifs.html", "destination": "/tarifs", "type": 301 },
      { "source": "/careers.html", "destination": "/careers", "type": 301 },
      { "source": "/ressources.html", "destination": "/ressources", "type": 301 },
      { "source": "/terms.html", "destination": "/terms", "type": 301 },
      { "source": "/privacy.html", "destination": "/privacy", "type": 301 },
      { "source": "/subprocessors.html", "destination": "/subprocessors", "type": 301 },
      { "source": "/google-limited-use.html", "destination": "/google-limited-use", "type": 301 },
      { "source": "/affiliate.html", "destination": "/affiliate", "type": 301 },
      { "source": "/compact", "destination": "/", "type": 301 },
      { "source": "/compact.html", "destination": "/", "type": 301 },
      {
        "source": "/downloads/Meetra.exe",
        "destination": "https://firebasestorage.googleapis.com/v0/b/forma-cad-dev.firebasestorage.app/o/downloads%2FMeetra.exe?alt=media",
        "type": 302
      },
      {
        "source": "/downloads/Hall.exe",
        "destination": "https://firebasestorage.googleapis.com/v0/b/forma-cad-dev.firebasestorage.app/o/downloads%2FMeetra.exe?alt=media",
        "type": 302
      },
      {
        "source": "/downloads/Hall-windows.exe",
        "destination": "https://firebasestorage.googleapis.com/v0/b/forma-cad-dev.firebasestorage.app/o/downloads%2FMeetra.exe?alt=media",
        "type": 302
      },
      {
        "source": "/downloads/Hall-mac.dmg",
        "destination": "https://firebasestorage.googleapis.com/v0/b/forma-cad-dev.firebasestorage.app/o/downloads%2FHall-mac.dmg?alt=media",
        "type": 302
      },
      {
        "source": "/downloads/Meetra-linux.AppImage",
        "destination": "https://firebasestorage.googleapis.com/v0/b/forma-cad-dev.firebasestorage.app/o/downloads%2FMeetra-linux.AppImage?alt=media",
        "type": 302
      },
      {
        "source": "/downloads/Hall-linux.AppImage",
        "destination": "https://firebasestorage.googleapis.com/v0/b/forma-cad-dev.firebasestorage.app/o/downloads%2FMeetra-linux.AppImage?alt=media",
        "type": 302
      },
      {
        "source": "/desktop-updates/:file",
        "destination": "https://firebasestorage.googleapis.com/v0/b/forma-cad-dev.firebasestorage.app/o/desktop-updates%2F:file?alt=media",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/auth",
        "headers": [
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          }
        ]
      },
      {
        "source": "/downloads/**",
        "headers": [
          { "key": "Content-Disposition", "value": "attachment" },
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      }
    ]
  }
}
